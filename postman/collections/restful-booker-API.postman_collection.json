        {
          "name": "Booking - PartialUpdateBooking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "id": "ad01b71d-e099-4d1f-95c6-87897f266dec",
                "exec": [
                  "function randomString(length) {",
                  "    return Math.random().toString(36).substring(2, 2 + length);",
                  "}",
                  "",
                  "function randomNumber(min, max) {",
                  "    return Math.floor(Math.random() * (max - min + 1)) + min;",
                  "}",
                  "",
                  "// Randomly decide which fields to update",
                  "const fieldsToUpdate = {};",
                  "",
                  "// 50% chance to update firstname",
                  "if (Math.random() < 0.5) {",
                  "    fieldsToUpdate.firstname = \"User_\" + randomString(5);",
                  "}",
                  "",
                  "// 50% chance to update lastname",
                  "if (Math.random() < 0.5) {",
                  "    fieldsToUpdate.lastname = \"Test_\" + randomString(5);",
                  "}",
                  "",
                  "// 50% chance to update totalprice",
                  "if (Math.random() < 0.5) {",
                  "    fieldsToUpdate.totalprice = randomNumber(50, 500);",
                  "}",
                  "",
                  "// 50% chance to update depositpaid",
                  "if (Math.random() < 0.5) {",
                  "    fieldsToUpdate.depositpaid = Math.random() < 0.5;",
                  "}",
                  "",
                  "// 50% chance to update bookingdates",
                  "if (Math.random() < 0.5) {",
                  "    const checkinDate = new Date();",
                  "    checkinDate.setDate(checkinDate.getDate() + randomNumber(1, 10));",
                  "",
                  "    const checkoutDate = new Date(checkinDate);",
                  "    checkoutDate.setDate(checkoutDate.getDate() + randomNumber(1, 10));",
                  "",
                  "    fieldsToUpdate.bookingdates = {",
                  "        checkin: checkinDate.toISOString().split(\"T\")[0],",
                  "        checkout: checkoutDate.toISOString().split(\"T\")[0]",
                  "    };",
                  "}",
                  "",
                  "// 50% chance to update additionalneeds",
                  "if (Math.random() < 0.5) {",
                  "    fieldsToUpdate.additionalneeds = \"Breakfast\";",
                  "}",
                  "",
                  "// Save as environment variable",
                  "pm.environment.set(\"patchRequestBody\", JSON.stringify(fieldsToUpdate));",
                  "",
                  "// Optional: log for debugging",
                  "console.log(\"PATCH request body:\", fieldsToUpdate);",
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
