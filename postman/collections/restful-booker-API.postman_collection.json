        {
          "name": "Booking - CreateBooking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "id": "ad01b71d-e099-4d1f-95c6-87897f266dec",
                "exec": [
                  "function randomString(length) {",
                  "    return Math.random().toString(36).substring(2, 2 + length);",
                  "}",
                  "",
                  "function randomNumber(min, max) {",
                  "    return Math.floor(Math.random() * (max - min + 1)) + min;",
                  "}",
                  "",
                  "const checkinDate = new Date();",
                  "checkinDate.setDate(checkinDate.getDate() + randomNumber(1, 10));",
                  "",
                  "const checkoutDate = new Date(checkinDate);",
                  "checkoutDate.setDate(checkoutDate.getDate() + randomNumber(1, 10));",
                  "",
                  "",
                  "const requestBody = {",
                  "    firstname: \"User_\" + randomString(5),",
                  "    lastname: \"Test_\" + randomString(5),",
                  "    totalprice: randomNumber(50, 500),",
                  "    depositpaid: Math.random() < 0.5,",
                  "    bookingdates: {",
                  "        checkin: checkinDate.toISOString().split(\"T\")[0],",
                  "        checkout: checkoutDate.toISOString().split(\"T\")[0]",
                  "    },",
                  "    additionalneeds: \"Breakfast\"",
                  "};",
                  "",
                  "pm.environment.set(\"requestBody\", JSON.stringify(requestBody));",
                  "",
                  "",
                  "/// Request TESTS",
                  "",
                  "",
                  "const request = JSON.parse(pm.environment.get(\"requestBody\"));",
                  "",
                  "pm.test(\"Request contains all required fields\", function () {",
                  "    const requiredFields = [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\", \"additionalneeds\"];",
                  "    requiredFields.forEach(field => {",
                  "        pm.expect(request).to.have.property(field);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Request field types are correct\", function () {",
                  "    pm.expect(request.firstname).to.be.a(\"string\");",
                  "    pm.expect(request.lastname).to.be.a(\"string\");",
                  "    pm.expect(request.totalprice).to.be.a(\"number\");",
                  "    pm.expect(request.depositpaid).to.be.a(\"boolean\");",
                  "    pm.expect(request.bookingdates).to.be.an(\"object\");",
                  "    pm.expect(request.bookingdates.checkin).to.be.a(\"string\");",
                  "    pm.expect(request.bookingdates.checkout).to.be.a(\"string\");",
                  "    pm.expect(request.additionalneeds).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"Checkout date is same or after checkin\", function () {",
                  "    const checkin = new Date(request.bookingdates.checkin);",
                  "    const checkout = new Date(request.bookingdates.checkout);",
                  "    pm.expect(checkout.getTime()).to.be.at.least(checkin.getTime());",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "id": "a5d56a6c-d796-4a0e-972f-f5ec8422642f",
                "exec": [
                  "// Parse response JSON",
                  "const response = pm.response.json();",
                  "",
                  "// Parse request JSON from environment variable",
                  "const request = JSON.parse(pm.environment.get(\"requestBody\"));",
                  "",
                  "// --- Status code ---",
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "// --- Booking ID exists ---",
                  "pm.test(\"Response contains bookingid\", function () {",
                  "    pm.expect(response).to.have.property(\"bookingid\");",
                  "    pm.expect(response.bookingid).to.be.a(\"number\");",
                  "});",
                  "",
                  "// --- Booking object matches request ---",
                  "pm.test(\"Response booking object matches request\", function () {",
                  "    const booking = response.booking;",
                  "    pm.expect(booking.firstname).to.eql(request.firstname);",
                  "    pm.expect(booking.lastname).to.eql(request.lastname);",
                  "    pm.expect(booking.totalprice).to.eql(request.totalprice);",
                  "    pm.expect(booking.depositpaid).to.eql(request.depositpaid);",
                  "    pm.expect(booking.bookingdates.checkin).to.eql(request.bookingdates.checkin);",
                  "    pm.expect(booking.bookingdates.checkout).to.eql(request.bookingdates.checkout);",
                  "    pm.expect(booking.additionalneeds).to.eql(request.additionalneeds);",
                  "});",
                  "",
                  "// --- Save booking ID for chaining ---",
                  "pm.environment.set(\"booking_id\", response.bookingid);",
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
