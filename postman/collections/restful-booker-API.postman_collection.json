          "name": "Auth - CreateToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "90de3203-ad00-421b-b50f-7c2766aabcfc",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test(\"Response schema is valid\", function () {",
                  "    var schema = {",
                  "        \"type\": \"object\",",
                  "        \"properties\": {",
                  "            \"token\": { \"type\": \"string\" }",
                  "        },",
                  "        \"required\": [\"token\"]",
                  "    };",
                  "    ",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "",
                  "pm.test(\"Save auth token to environment\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"auth_token\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "id": "05476016-e499-4c41-9272-10b1eeb191da",
                "exec": [
                  "pm.test(\"Request Body should be valid JSON\", function () {",
                  "    pm.expect(() => {",
                  "        JSON.parse(pm.request.body.raw);",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"Request body schema is valid\", function () {",
                  "    const body = JSON.parse(pm.request.body.raw);",
                  "",
                  "    // Required fields",
                  "    pm.expect(body).to.have.property(\"username\");",
                  "    pm.expect(body).to.have.property(\"password\");",
                  "",
                  "    // Data types",
                  "    pm.expect(body.username).to.be.a(\"string\");",
                  "    pm.expect(body.password).to.be.a(\"string\");",
                  "",
                  "    // No extra fields",
                  "    const allowedKeys = [\"username\", \"password\"];",
                  "    Object.keys(body).forEach(key => {",
                  "        pm.expect(allowedKeys).to.include(key);",
                  "    });",
                  "});",
                  "",
                  "",
                  "pm.test(\"Username and password are not empty\", function () {",
                  "    const body = JSON.parse(pm.request.body.raw);",
                  "    pm.expect(body.username.trim()).to.not.equal(\"\");",
                  "    pm.expect(body.password.trim()).to.not.equal(\"\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
