                  "// Schema for successful delete-booking response",
                  "const schema = {",
                  "    \"type\": \"object\",",
                  "    \"properties\": {",
                  "        \"firstname\": { \"type\": \"string\" },",
                  "        \"lastname\": { \"type\": \"string\" },",
                  "        \"totalprice\": { \"type\": \"number\" },",
                  "        \"depositpaid\": { \"type\": \"boolean\" },",
                  "        \"bookingdates\": {",
                  "            \"type\": \"object\",",
                  "            \"properties\": {",
                  "                \"checkin\": { \"type\": \"string\" },",
                  "                \"checkout\": { \"type\": \"string\" }",
                  "            },",
                  "            \"required\": [\"checkin\", \"checkout\"]",
                  "        },",
                  "        \"additionalneeds\": { \"type\": \"string\" }",
                  "    },",
                  "    \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\", \"additionalneeds\"]",
                  "};",
                  "",
                  "// Check if response is JSON by examining Content-Type header",
                  "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "const isJsonResponse = contentType.includes(\"application/json\");",
                  "",
                  "// Try to parse JSON safely",
                  "let jsonData = null;",
                  "let isValidJson = false;",
                  "",
                  "if (isJsonResponse) {",
                  "    try {",
                  "        jsonData = pm.response.json();",
                  "        isValidJson = true;",
                  "    } catch (e) {",
                  "        isValidJson = false;",
                  "    }",
                  "}",
                  "",
                  "pm.test(\"Response status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "// Run schema validation only if response is valid JSON",
                  "if (isValidJson && jsonData) {",
                  "    pm.test(\"Response booking object matches schema\", function () {",
                  "        pm.response.to.have.jsonSchema(schema);",
                  "    });",
                  "} else {",
                  "    // For non-JSON responses (e.g., 405 Method Not Allowed), check body content",
                  "    pm.test(\"Response body is present\", function () {",
                  "        pm.expect(pm.response.text()).to.be.a('string').and.not.be.empty;",
                  "    });",
                  "    ",
                  "    // Log info about non-JSON response for debugging",
                  "    console.log(\"Non-JSON response received. Status: \" + pm.response.code + \", Body: \" + pm.response.text());",
                  "}"
